.theme-container,
body
  max-width 100%
  overflow-x hidden

.theme-container
  box-sizing border-box
  width 100% !important

.home-wrapper
  .main-wrapper
    .main-left
      max-width 1100px
      width 100%
    .theme-vdoing-content.custom
      max-width 1100px
      width 100%
      box-sizing border-box
  .banner
    min-height 560px
    border-bottom 1px solid #e5e7eb
    color #111111
    position relative
    overflow hidden
    &:before
      content ''
      position absolute
      inset 0
      pointer-events none
      background-image linear-gradient(rgba(15, 23, 42, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, .055) 1px, transparent 1px)
      background-size 34px 34px
      mask-image linear-gradient(to bottom, black, transparent 88%)
      -webkit-mask-image linear-gradient(to bottom, black, transparent 88%)
    .banner-conent
      position relative
      z-index 1
      .hero
        text-align center !important
        max-width 920px
        margin 0 auto
        padding 3.2rem 1rem 0
        h1
          color #111111
          font-size 2.75rem
          line-height 1.08
          letter-spacing 0
          text-align center !important
        .description
          margin 1rem 0 .8rem
          max-width 46rem
          color #555555
          font-size 1.08rem
          line-height 1.75
          text-align center !important
          margin-left auto
          margin-right auto
        .action
          margin 1.1rem 0 .35rem !important
          text-align center !important
        .action-button
          border-radius 6px
          background #128477 !important
          border 1px solid #128477 !important
          color #ffffff !important
          font-weight 700
          box-shadow 0 14px 34px rgba(17, 24, 39, .16)
          &:hover
            background #0f766e !important
            border-color #0f766e !important
      .features
        display grid !important
        grid-template-columns repeat(3, minmax(0, 1fr))
        gap 1rem
        padding 0 1rem 1.8rem !important
        margin-top 1.5rem !important
      .feature
        max-width none !important
        width auto !important
        min-height 156px
        box-sizing border-box
        text-align left
        padding 1.15rem
        border 1px solid rgba(17, 24, 39, .08)
        border-radius 8px
        background rgba(255, 255, 255, .86)
        backdrop-filter blur(14px)
        -webkit-backdrop-filter blur(14px)
        box-shadow inset 0 0 0 1px rgba(15, 23, 42, .04), 0 18px 48px rgba(15, 23, 42, .08)
        transition border-color .15s ease, transform .15s ease
        &:hover
          border-color rgba(15, 118, 110, .28)
          transform translateY(-2px)
        a h2
          color #111111
          font-size 1.08rem
          font-weight 700
        a p
          color #666666
          padding 0
          line-height 1.7
          opacity 1

.home-polish
  max-width 1100px
  margin 0 auto
  padding 1.35rem 1rem 0
  color var(--textColor)
  .eyebrow
    margin 0 0 .4rem
    color #0f766e
    font-size .86rem
    font-weight 700
  h2
    border-bottom 0
    padding-bottom 0
    margin 0 0 .8rem
    font-size 1.7rem
    letter-spacing 0
  p
    line-height 1.8
  a
    text-decoration none
  .quick-panel
    display grid
    grid-template-columns 1.45fr .85fr
    gap 1.5rem
    align-items center
    padding 1.45rem
    border 1px solid #e5e7eb
    border-radius 8px
    background radial-gradient(circle at 15% 15%, rgba(16, 163, 127, .08), transparent 32%), linear-gradient(135deg, rgba(255, 255, 255, .94), rgba(248, 250, 252, .9))
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    box-shadow 0 14px 36px rgba(15, 23, 42, .06)
  .quick-actions
    display grid
    gap .65rem
    a
      display block
      padding .82rem 1rem
      border 1px solid #dddddd
      border-radius 6px
      color #222222
      font-weight 700
      &.primary-link
        background #ffffff
        border-color #dddddd
        color #222222
        box-shadow none
        &:hover
          background #ffffff
          border-color #0f766e
          color #222222
      &:hover
        border-color #0f766e
  .guide-grid
    display grid
    grid-template-columns repeat(4, 1fr)
    gap 1rem
    margin 1.4rem 0
    a
      min-height 190px
      padding 1.15rem
      border 1px solid #e5e7eb
      border-radius 8px
      background #ffffff
      color #222222
      box-shadow 0 10px 28px rgba(15, 23, 42, .045)
      transition transform .15s ease, border-color .15s ease, box-shadow .15s ease
      &:hover
        transform translateY(-2px)
        border-color rgba(15, 118, 110, .34)
        box-shadow 0 16px 34px rgba(15, 23, 42, .08)
      span
        color #0f766e
        font-weight 800
      h3
        margin .55rem 0
        font-size 1.05rem
      p
        margin 0
        font-size .94rem
  .compare-section
    margin 1.5rem 0
    padding 1.4rem
    border 1px solid #e5e7eb
    border-radius 8px
    background #ffffff
    box-shadow 0 12px 30px rgba(15, 23, 42, .045)
  .compare-table
    border 1px solid #e5e7eb
    border-radius 8px
    overflow hidden
    .row
      display grid
      grid-template-columns .7fr 1.1fr 1.2fr
      gap 1rem
      padding .95rem 1rem
      border-top 1px solid #eeeeee
      &:first-child
        border-top 0
      &.head
        background #ecfdf5
      span
        line-height 1.65
  .trust-strip
    display grid
    grid-template-columns repeat(3, 1fr)
    gap 1rem
    margin 1.4rem 0
    div
      padding 1.05rem
      border-radius 8px
      border 1px solid #e5e7eb
      background linear-gradient(180deg, #ffffff, #f8fafc)
      strong
        display block
        margin-bottom .35rem
      span
        line-height 1.7
  .latest-section
    margin 1.5rem 0
    padding 1.4rem
    border 1px solid #e5e7eb
    border-radius 8px
    background radial-gradient(circle at 92% 10%, rgba(16, 163, 127, .08), transparent 30%), linear-gradient(180deg, #ffffff, #f8fafc)
    box-shadow 0 12px 30px rgba(15, 23, 42, .045)
  .latest-list
    display grid
    gap .7rem
    a
      display grid
      grid-template-columns 5rem 1fr
      gap 1rem
      align-items center
      padding .82rem .95rem
      border 1px solid #e8edf3
      border-radius 6px
      background #ffffff
      color #222222
      span
        color #0f766e
        font-weight 800
      strong
        font-weight 700
        line-height 1.55
  .more-link
    display inline-block
    margin-top 1rem
    color #0f766e
    font-weight 700
  .link-cloud
    margin 1.6rem 0 0
    padding 1.3rem
    border-top 1px solid #eeeeee
    p
      display flex
      flex-wrap wrap
      gap .6rem
    a
      padding .45rem .75rem
      border 1px solid #e5e7eb
      border-radius 6px
      color #333333
      background #ffffff
      &:hover
        border-color #0f766e

@media (max-width 959px)
  .home-wrapper
    .banner
      min-height 500px
      .banner-conent
        .hero
          text-align center
          padding 3.6rem 1rem .45rem
          h1
            font-size 2.25rem
            text-align center !important
          .description
            margin 1.2rem auto
            text-align center !important
          .action
            text-align center !important
        .features
          grid-template-columns 1fr
          padding 1rem
        .feature
          text-align center
  .home-polish
    .quick-panel,
    .guide-grid,
    .trust-strip
      grid-template-columns 1fr
    .compare-table .row
      grid-template-columns 1fr
      gap .3rem
    .latest-list a
      grid-template-columns 1fr
      gap .25rem
