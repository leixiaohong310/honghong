.theme-container,
body
  max-width 100%
  overflow-x hidden

.theme-container
  box-sizing border-box
  width 100% !important

.home-wrapper
  .main-wrapper
    .main-left
      max-width 1100px
      width 100%
    .theme-vdoing-content.custom
      max-width 1100px
      width 100%
      box-sizing border-box
  .banner
    min-height 520px
    border-bottom 1px solid #e5e7eb
    color #111111
    position relative
    overflow hidden
    &:before
      content ''
      position absolute
      inset 0
      pointer-events none
      background-image linear-gradient(rgba(15, 23, 42, .055) 1px, transparent 1px), linear-gradient(90deg, rgba(15, 23, 42, .055) 1px, transparent 1px)
      background-size 34px 34px
      mask-image linear-gradient(to bottom, black, transparent 88%)
      -webkit-mask-image linear-gradient(to bottom, black, transparent 88%)
    .banner-conent
      position relative
      z-index 1
      .hero
        text-align center !important
        max-width 920px
        margin 0 auto
        padding 2.75rem 1rem 0
        h1
          color #111111
          font-size 2.58rem
          line-height 1.12
          letter-spacing 0
          font-weight 800
          text-align center !important
        .description
          margin .9rem 0 .55rem
          max-width 46rem
          color #555555
          font-size 1.04rem
          line-height 1.68
          text-align center !important
          margin-left auto
          margin-right auto
        .action
          margin .95rem 0 .2rem !important
          text-align center !important
        .action-button
          border-radius 7px
          background #159280 !important
          border 1px solid #159280 !important
          color #ffffff !important
          font-weight 700
          box-shadow 0 10px 26px rgba(15, 118, 110, .18)
          transition background .15s ease, border-color .15s ease, box-shadow .15s ease, transform .15s ease
          &:hover
            background #127f72 !important
            border-color #127f72 !important
            box-shadow 0 14px 30px rgba(15, 118, 110, .2)
            transform translateY(-1px)
      .features
        display grid !important
        grid-template-columns repeat(3, minmax(0, 1fr))
        gap 1rem
        padding 0 1rem 1.5rem !important
        margin-top 1.25rem !important
      .feature
        max-width none !important
        width auto !important
        min-height 138px
        box-sizing border-box
        text-align left
        padding 1rem 1.05rem
        border 1px solid rgba(17, 24, 39, .08)
        border-radius 8px
        background rgba(255, 255, 255, .9)
        backdrop-filter blur(12px)
        -webkit-backdrop-filter blur(12px)
        box-shadow inset 0 0 0 1px rgba(15, 23, 42, .025), 0 12px 30px rgba(15, 23, 42, .055)
        transition border-color .15s ease, transform .15s ease, box-shadow .15s ease
        &:hover
          border-color rgba(15, 118, 110, .28)
          transform translateY(-2px)
          box-shadow inset 0 0 0 1px rgba(15, 118, 110, .06), 0 16px 34px rgba(15, 23, 42, .07)
        a h2
          color #111111
          font-size 1.02rem
          font-weight 700
          line-height 1.4
        a p
          color #666666
          padding 0
          line-height 1.65
          opacity 1

.home-polish
  max-width 1100px
  margin 0 auto
  padding 1.15rem 1rem 0
  color var(--textColor)
  .eyebrow
    margin 0 0 .4rem
    color #0f766e
    font-size .86rem
    font-weight 700
  h2
    border-bottom 0
    padding-bottom 0
    margin 0 0 .7rem
    font-size 1.58rem
    letter-spacing 0
  p
    line-height 1.8
  a
    text-decoration none
  .quick-panel
    display grid
    grid-template-columns 1.45fr .85fr
    gap 1.5rem
    align-items center
    padding 1.35rem
    border 1px solid #e5e7eb
    border-radius 8px
    background radial-gradient(circle at 15% 15%, rgba(16, 163, 127, .07), transparent 32%), linear-gradient(135deg, rgba(255, 255, 255, .95), rgba(248, 250, 252, .9))
    backdrop-filter blur(12px)
    -webkit-backdrop-filter blur(12px)
    box-shadow 0 10px 28px rgba(15, 23, 42, .045)
  .quick-actions
    display grid
    gap .65rem
    a
      display block
      padding .78rem .95rem
      border 1px solid #e1e5ea
      border-radius 6px
      color #222222
      font-weight 700
      &.primary-link
        background #ffffff
        border-color #dddddd
        color #222222
        box-shadow none
        &:hover
          background #ffffff
          border-color #0f766e
          color #222222
      &:hover
        border-color #0f766e
  .guide-grid
    display grid
    grid-template-columns repeat(4, 1fr)
    gap 1rem
    margin 1.25rem 0
    a
      min-height 176px
      padding 1.05rem
      border 1px solid #e5e7eb
      border-radius 8px
      background #ffffff
      color #222222
      box-shadow 0 8px 24px rgba(15, 23, 42, .04)
      transition transform .15s ease, border-color .15s ease, box-shadow .15s ease
      &:hover
        transform translateY(-2px)
        border-color rgba(15, 118, 110, .34)
        box-shadow 0 14px 30px rgba(15, 23, 42, .065)
      span
        color #0f766e
        font-weight 800
      h3
        margin .5rem 0
        font-size 1.02rem
        line-height 1.45
      p
        margin 0
        font-size .92rem
  .compare-section
    margin 1.5rem 0
    padding 1.4rem
    border 1px solid #e5e7eb
    border-radius 8px
    background #ffffff
    box-shadow 0 12px 30px rgba(15, 23, 42, .045)
  .compare-table
    border 1px solid #e5e7eb
    border-radius 8px
    overflow hidden
    .row
      display grid
      grid-template-columns .7fr 1.1fr 1.2fr
      gap 1rem
      padding .95rem 1rem
      border-top 1px solid #eeeeee
      &:first-child
        border-top 0
      &.head
        background #ecfdf5
      span
        line-height 1.65
  .trust-strip
    display grid
    grid-template-columns repeat(3, 1fr)
    gap 1rem
    margin 1.25rem 0
    div
      padding .95rem 1rem
      border-radius 8px
      border 1px solid #e5e7eb
      background linear-gradient(180deg, #ffffff, #f8fafc)
      box-shadow 0 8px 22px rgba(15, 23, 42, .035)
      strong
        display block
        margin-bottom .35rem
      span
        line-height 1.7
  .latest-section
    margin 1.35rem 0
    padding 1.25rem
    border 1px solid #e5e7eb
    border-radius 8px
    background radial-gradient(circle at 92% 10%, rgba(16, 163, 127, .06), transparent 30%), linear-gradient(180deg, #ffffff, #f8fafc)
    box-shadow 0 10px 26px rgba(15, 23, 42, .04)
  .latest-list
    display grid
    gap .7rem
    a
      display grid
      grid-template-columns 5rem 1fr
      gap 1rem
      align-items center
      padding .76rem .9rem
      border 1px solid #e8edf3
      border-radius 6px
      background #ffffff
      color #222222
      transition border-color .15s ease, background .15s ease
      &:hover
        border-color rgba(15, 118, 110, .3)
        background #fbfefd
      span
        color #0f766e
        font-weight 800
      strong
        font-weight 700
        line-height 1.55
  .more-link
    display inline-block
    margin-top 1rem
    color #0f766e
    font-weight 700
  .link-cloud
    margin 1.35rem 0 0
    padding 1.1rem 0 0
    border-top 1px solid #eeeeee
    h2
      font-size 1.28rem
    p
      display flex
      flex-wrap wrap
      gap .5rem
    a
      padding .4rem .68rem
      border 1px solid #e5e7eb
      border-radius 6px
      color #555555
      background rgba(255, 255, 255, .78)
      &:hover
        border-color #0f766e
        color #222222

@media (max-width 959px)
  .home-wrapper
    .main-wrapper
      .theme-vdoing-content.custom
        padding-left 1rem !important
        padding-right 1rem !important
    .banner
      min-height 390px
      .banner-conent
        .hero
          text-align center
          padding 2.65rem 1rem .15rem
          h1
            font-size 1.95rem
            line-height 1.18
            text-align center !important
          .description
            margin .8rem auto .65rem
            font-size .92rem
            line-height 1.55
            text-align center !important
          .action
            margin .65rem 0 .05rem !important
            text-align center !important
          .action-button
            padding .66rem .95rem
            font-size .92rem
        .features
          grid-template-columns 1fr
          padding 1rem
        .feature
          text-align center
          background rgba(255, 255, 255, .92) !important
          border-color rgba(17, 24, 39, .1) !important
          a
            color #222222 !important
          a h2
            color #111111 !important
          a p
            color #666666 !important
            opacity 1 !important
    .slide-banner
      margin-top .55rem !important
      .slide-banner-wrapper
        height 182px !important
      .slide-item
        height 182px !important
        min-height 0 !important
        display inline-flex !important
        align-items center
        justify-content center
        padding .8rem 1.1rem !important
        box-sizing border-box
        border 1px solid rgba(17, 24, 39, .08)
        border-radius 8px
        box-shadow 0 10px 24px rgba(15, 23, 42, .055)
        a h2
          margin .25rem 0 .45rem
          font-size 1.03rem !important
          line-height 1.4
        a p
          max-width 20rem
          margin 0 auto
          padding 0 !important
          font-size .9rem
          line-height 1.55
      .docs-wrapper
        bottom 8px !important
    .slide-item
      background rgba(255, 255, 255, .92) !important
      a
        color #222222 !important
      a h2
        color #111111 !important
      a p
          color #666666 !important
          opacity 1 !important
  .home-polish
    padding .85rem 1rem 0
    h2
      font-size 1.45rem
      line-height 1.35
    .quick-panel,
    .guide-grid,
    .trust-strip
      grid-template-columns 1fr
    .quick-panel
      gap 1rem
      padding 1.2rem
    .guide-grid
      gap .85rem
      margin 1rem 0
      a
        min-height auto
        padding 1rem
    .trust-strip
      gap .85rem
      margin 1rem 0
    .latest-section
      margin 1.05rem 0
      padding 1.05rem
    .compare-table .row
      grid-template-columns 1fr
      gap .3rem
    .latest-list a
      grid-template-columns 1fr
      gap .25rem
